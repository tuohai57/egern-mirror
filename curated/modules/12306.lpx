# 2025-07-06
# https://github.com/kokoryh/Sparkle/blob/master/release/surge/module/12306.sgmodule

[Rule]
# 放行规则
DOMAIN, ad.12306.cn, DIRECT

[Script]
request if ${url} ~= /^https:\/\/ad\.12306\.cn\/ad\/ser\/getAdList$/i then script("https://cdn.jsdelivr.net/gh/tuohai57/egern-mirror@main/scripts/12306.js") with tag="[铁路12306]移除开屏广告", requires_body=true

request if ${url} ~= /^https:\/\/mobile\.12306\.cn\/otsmobile\/app\/mgs\/mgw\.htm$/i then script("https://cdn.jsdelivr.net/gh/tuohai57/egern-mirror@main/scripts/12306.js") with tag="[铁路12306]移除应用内广告"

[MitM]
hostname = ad.12306.cn, mobile.12306.cn