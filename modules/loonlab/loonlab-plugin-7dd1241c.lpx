#!name = 喜马拉雅
#!desc = 过滤喜马拉雅广告
#!openUrl = https://apps.apple.com/app/id876336838
#!author = 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!tag = 去广告
#!system = 
#!system_version = 
#!loon_version = 3.5.2(1005)
#!homepage = https://loonlab.103516.xyz/Plugin/
#!icon = https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/HimalayaFM.png
#!date = 2026-10-02 12:00

# 2026-10-02 13:57:49
# https://kelee.one/Tool/Loon/Lpx/Himalaya_remove_ads.lpx

[Rule]
# 广告下发
DOMAIN, adse.ximalaya.com, REJECT
DOMAIN, adsehera.ximalaya.com, REJECT
DOMAIN, adse.wsa.ximalaya.com, REJECT
DOMAIN, adbehavior.ximalaya.com, REJECT
DOMAIN, adbehavior.wsa.ximalaya.com, REJECT

[Rewrite]
# 搜索 - 搜索填充词、推荐搜索
request if ${url} ~= /^https:\/\/(?:search|searchwsa)\.ximalaya\.com\/hub\/(guideWord|hotWord)V\d\//i then reject_dict(200)

# 首页 - 推荐 - 推荐卡片
response if ${url} ~= /^https:\/\/(?:mobile|mobilehera|mobwsa)\.ximalaya\.com\/discovery-feed\/v\d\/mix\//i then response.json.jq(".heData |= map(select(.item.list[].bizType != \"SceneListenCard\"))")
request if ${url} ~= /^https:\/\/(?:mobile|mobilehera|mobwsa)\.ximalaya\.com\/discovery-feed\/v\d\/scene\/listen\/refresh\?/i then reject_dict(200)

# 首页 - 右上角红包
request if ${url} ~= /^https:\/\/(?:m|mwsa)\.ximalaya\.com\/x-web-activity\/signIn\/getHomePageSignInInfo\//i then reject_dict(200)

# 首页 - 精简频道分类
response if ${url} ~= /^https:\/\/(?:mobile|mobilehera|mobwsa)\.ximalaya\.com\/discovery-category\/customCategories\//i then response.json.jq(".categoryList |= map(.itemList |= map(select(.title | test(\"直播|123狂欢节|SVIP\"; \"i\") | not))) | .customCategoryList |= map(select(.title | test(\"直播|123狂欢节|SVIP\"; \"i\") | not))")

# 全局广告
response if ${url} ~= /^https:\/\/(?:mobile|mobilehera|mobwsa)\.ximalaya\.com\/football-portal\/diff2\/batch\?/i then response.json.delete(["json.ad", "json.toc"])

# 订阅 - 精简类别
response if ${url} ~= /^https:\/\/(?:mobile|mobilehera|mobwsa)\.ximalaya\.com\/nexus-web\/v\d\/tabs\/customTabs\?/i then response.json.jq(".data.feedTabs |= map(select(.name != \"大赛\"))")

# 订阅 - 订阅推荐
request if ${url} ~= /^https:\/\/(?:mobile|mobilehera|mobwsa)\.ximalaya\.com\/subscribe\/v\d\/subscribe\/tagAlbumList$/i then reject_dict(200)

# 订阅 - 追更 -追更推荐
request if ${url} ~= /^https:\/\/(?:mobile|mobilehera|mobwsa)\.ximalaya\.com\/track-feed\/v\d\/chase\/recommend\//i then reject_dict(200)

# 订阅 - 关注 - 精选节目推荐
request if ${url} ~= /^https:\/\/(?:mobile|mobilehera|mobwsa)\.ximalaya\.com\/social-web\/follow-stream\/category\/\d+$/i then reject_dict(200)

# 订阅 - 圈子 - 圈子推荐
response if ${url} ~= /^https:\/\/(?:m|mwsa)\.ximalaya\.com\/community\/square\/v\d\/stream\?/i then response.body.mock("json", "{\"data\":{\"cards\":[{\"content\":{},\"type\":\"RECOMMENDS\"}]},\"ret\":0}", 200)

# 播放器 - 提示语
response if ${url} ~= /^https:\/\/mobwsa\.ximalaya\.com\/mobile-playpage\/playpage\/tabs\/v2\//i then response.json.delete(["data.playpage.resourceMap.defaultResource", "data.playpage.resourceMap.playPageTip"])

# 播放器 - 推荐
request if ${url} ~= /^https:\/\/(?:mobile|mobilehera|mobwsa)\.ximalaya\.com\/mobile-playpage\/playpage\/recommendContentV\d\//i then reject_dict(200)

# 播放器 - 推广
request if ${url} ~= /^https:\/\/(?:mobile|mobilehera|mobwsa)\.ximalaya\.com\/mobile-playpage\/playpage\/recommend\/resource\/allocation\//i then reject_dict(200)

# 弹窗
request if ${url} ~= /^https:\/\/(?:mobile|mobilehera|mobwsa)\.ximalaya\.com\/firework-portal\/v\d+\/sync\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/(?:mobile|mobilehera|mobwsa)\.ximalaya\.com\/business-sale-promotion-guide-mobile-web\/popup\//i then reject_dict(200)

# 皮肤配置
request if ${url} ~= /^https:\/\/(?:mobile|mobilehera|mobwsa)\.ximalaya\.com\/app-skin-service\/skin\/setting\/info\//i then reject_dict(200)

# 我的页面 - 右上角免费听图标
response if ${url} ~= /^https:\/\/(?:mobile|mobilehera|mobwsa)\.ximalaya\.com\/mobile-user\/v\d\/homePage\//i then response.json.delete("data.freeListenV2")

# 我的页面 - 直播提醒气泡
request if ${url} ~= /^https:\/\/(?:live|livewsa)\.ximalaya\.com\/lamia\/v1\/subscribe\/status$/i then reject_dict(200)

# 我的页面 - 服务模块
response if ${url} ~= /^https:\/\/(?:mobile|mobilehera|mobwsa)\.ximalaya\.com\/mobile-user\/v\d\/homePage\//i then response.json.jq(".data.serviceModule.entrances |= map(select(.name == \"全部服务\"))")

# 我的页面 - 本地 - 你可能感兴趣的内容
request if ${url} ~= /^https:\/\/(?:mobile|mobilehera|mobwsa)\.ximalaya\.com\/subscribe\/v\d\/subscribe\/recommend\?/i then reject_dict(200)

# 我的页面 - 已购 - 为你推荐
request if ${url} ~= /^https:\/\/(?:mobile|mobilehera|mobwsa)\.ximalaya\.com\/mobile-user\/v\d\/purchased\/recommend\//i then reject_dict(200)

[MitM]
hostname = gslbali.ximalaya.com, search.ximalaya.com, searchwsa.ximalaya.com, mobile.ximalaya.com, mobilehera.ximalaya.com, mobwsa.ximalaya.com, m.ximalaya.com, mwsa.ximalaya.com