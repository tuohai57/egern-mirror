#!name = V2EX
#!desc = 过滤V2EX社区广告；V2EX每日签到，访问V2EX个人主页自动获取保存Cookie。
#!openUrl = https://v2ex.com/
#!author = ddgksf2013[https://github.com/ddgksf2013], curtinp118[https://github.com/curtinp118]
#!tag = 去广告
#!system = 
#!system_version = 
#!loon_version = 3.5.2(1005)
#!homepage = https://loonlab.103516.xyz/Plugin/
#!icon = https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/V2EX-03.png
#!date = 2026-10-02 12:00

# 2026-07-07
# https://ddgksf2013.top/scripts/v2ex.ads.js
# 2026-05-30
# https://raw.githubusercontent.com/curtinp118/Loon/main/plugins/v2ex.lpx

[Argument]
Cookie-V2EX = switch, true, false, tag = [V2EX]每日签到Cookie, desc = 获取[V2EX]每日签到Cookie
Task-V2EX = switch, true, false, tag = [V2EX]每日签到Task, desc = 定时运行[V2EX]每日签到Task
Cron-V2EX = input, "0 0 9 * * *", tag = [V2EX]定时参数Cron, desc = 输入Cron表达式来定时运行[V2EX]每日签到Task

[Rule]
DOMAIN-SUFFIX, v2ex.com, PROXY

[Rewrite]
^https?:\/\/pagead.*googlesyndication\.com\/pagead reject-200
^https?:\/\/.*v2ex\.com\/pro\/emitter reject-200

[Script]
request if ${url} ~= /^https?:\/\/www\.v2ex\.com\/(mission|member).*$/i then script("https://raw.githubusercontent.com/curtinp118/Scripthub/main/scripts/v2ex/v2ex.js") with enable=${Cookie-V2EX}, tag="[V2EX]每日签到Cookie", timeout=10
cron ${Cron-V2EX} then script("https://raw.githubusercontent.com/curtinp118/Scripthub/main/scripts/v2ex/v2ex.js") with enable=${Task-V2EX}, tag="[V2EX]每日签到Task", timeout=60

response if ${url} ~= /^https?:\/\/.*v2ex\.com\/(?!(.*(api|login|cdn-cgi|verify|auth|captch|(\.(js|css|jpg|jpeg|png|webp|gif|zip|woff|woff2|m3u8|mp4|mov|m4v|avi|mkv|flv|rmvb|wmv|rm|asf|asx|mp3|json|ico|otf|ttf)))))/i then script("https://ddgksf2013.top/scripts/v2ex.ads.js") with tag="[V2EX]移除广告", requires_body=true

[MitM]
hostname = *.v2ex.com, pagead*.googlesyndication.com