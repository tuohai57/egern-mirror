# 2026-10-02 13:57:49
# https://kelee.one/Tool/Loon/Lpx/HonorOfKingsGameHelper_remove_ads.lpx

[Rewrite]
# 移除开屏广告、弹窗推广、搜索热搜、搜索热榜、底栏推广图标
request if ${url} ~= /^https:\/\/app\.mval\.qq\.com\/go\/recommend\/platflashbox\?/i then reject_dict(200)

request if ${url} ~= /^https:\/\/app\.mval\.qq\.com\/go\/mlol_news\/search\/varcache_hotV\d\?/i then reject_dict(200)

request if ${url} ~= /^https:\/\/app\.mval\.qq\.com\/go\/customize_search\/article_rank\?/i then reject_dict(200)

[MitM]
hostname = app.mval.qq.com