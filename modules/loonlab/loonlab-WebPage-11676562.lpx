# 2026-08-30 10:10
# https://rucu6.pages.dev/Plugins/webpage.lpx
# 2024-07-23
# https://github.com/kokoryh/Sparkle/blob/master/release/surge/module/missav.sgmodule
# 2025-07-26
# https://github.com/kokoryh/Sparkle/blob/master/release/surge/module/hanime.sgmodule
# 2025-08-03
# https://github.com/kokoryh/Sparkle/blob/master/release/surge/module/ehentai.sgmodule

[Rule]
# -----------kokoryh----------- #
# MissAV
DOMAIN-SUFFIX, creative.myavlive.com, REJECT
DOMAIN-SUFFIX, trackwilltrk.com, REJECT
DOMAIN-SUFFIX, tsyndicate.com, REJECT

# Hanime
DOMAIN-SUFFIX, jads.co, REJECT
DOMAIN-SUFFIX, juicyads.com, REJECT
DOMAIN-SUFFIX, mnaspm.com, REJECT

[Rewrite]
# -----------Rucu6----------- #
# Avple 跳转弹窗 //asserts.avple.tv
request if ${url} ~= /^https:\/\/asserts\.avple\.tv\/file\/avple-images\/ad\.js/i then reject(404)

# E-Hentai (https://e-hentai.org) //e-hentai.org, exhentai.org
request if ${url} ~= /^https:\/\/exhentai\.org/i then redirect(307, "https://e-hentai.org")

# PornHub (https://cn.pornhub.com/) //*.pornhub.com
request if ${url} ~= /^(https:\/\/cn\.pornhub\.com\/view_video\.php\?viewkey=[^&]+)&.*$/i as urlMatch then redirect(302, "${urlMatch.1}")
request if ${url} ~= /^https:\/\/www\.pornhub\.com\//i then redirect(302, "https://cn.pornhub.com/")
request if ${url} ~= /^https:\/\/cn\.pornhub\.com\/(?:interstitial|_xa\/ads)/i then reject_dict(200)

[Script]
# -----------kokoryh----------- #
# MissAV
# response if ${url} ~= /^https:\/\/missav\.(?:ai|ws)\/(?!favicon)(?!(build|fonts|img|js|api|cdn-cgi)\/)./i then script("https://raw.githubusercontent.com/kokoryh/Sparkle/master/dist/webpage.missav.js") with tag="[WebPage]MissAV", requires_body=true

# Hanime
response if ${url} ~= /^https:\/\/hanime1\.me\/(?!(favicon|css|js|cdn-cgi|load))/i then script("https://raw.githubusercontent.com/kokoryh/Sparkle/master/dist/webpage.hanime.js") with tag="[WebPage]Hanime", requires_body=true

# E-Hentai
response if ${url} ~= /^https:\/\/e-hentai\.org\/g\//i then script("https://raw.githubusercontent.com/kokoryh/Sparkle/master/dist/webpage.ehentai.js") with tag="[WebPage]E-Hentai", requires_body=true

# -----------RuCu6----------- #
# 百度 //boxer.baidu.com, m.baidu.com, www.baidu.com, zhidao.baidu.com
request if ${url} ~= /^https:\/\/boxer\.baidu\.com\/scheme\?scheme/i then script("https://rucu6.pages.dev/Scripts/baidu/baiduNoRedirect.js") with tag="[WebPage]百度防跳转", timeout=10, requires_body=true, binary_body_mode=false
response if ${url} ~= /^https:\/\/(?:www|m)\.baidu\.com(\/|\/\?(tn=&)?from=\d+\w)?$/i then script("https://rucu6.pages.dev/Scripts/webpage/baidu-index.js") with tag="[WebPage]百度首页", timeout=10, requires_body=true, binary_body_mode=false
response if ${url} ~= /^https:\/\/zhidao\.baidu\.com\/(?:question|index|\?fr|\?word)/i then script("https://rucu6.pages.dev/Scripts/webpage/baidu-zhidao.js") with tag="[WebPage]百度知道", timeout=10, requires_body=true, binary_body_mode=false

# 观影 //www.hgeme.com, www.xn--wcv59z.com
response if ${url} ~= /^https:\/\/www\.(?:hgeme|xn--wcv59z)\.com\//i then script("https://rucu6.pages.dev/Scripts/webpage/myblockads.js") with tag="[WebPage]观影", timeout=10, requires_body=true, binary_body_mode=false

# 移花宫 //yhg007.com, *.111107?.xyz
response if ${url} ~= /^https:\/\/(?:yhg007\.com|[a-z]{8}\.111107\d\.xyz)\/hash\/(?:[a-fA-F0-9]{40}|[A-Z2-7]{32})\.html$/i then script("https://rucu6.pages.dev/Scripts/webpage/myblockads.js") with tag="[WebPage]移花宫", timeout=10, requires_body=true, binary_body_mode=false
response if ${url} ~= /^https:\/\/(?:yhg007\.com|[a-z]{8}\.111107\d\.xyz)\/search-[^\/]+\.html$/i then script("https://rucu6.pages.dev/Scripts/webpage/myblockads.js") with tag="[WebPage]移花宫", timeout=10, requires_body=true, binary_body_mode=false

# 黑料网 //18hlw.com, 8olbt.imsatcmn.cc
response if ${url} ~= /^https:\/\/(?:18hlw\.com|8olbt\.imsatcmn\.cc)\//i then script("https://rucu6.pages.dev/Scripts/webpage/myblockads.js") with tag="[WebPage]黑料网", timeout=10, requires_body=true, binary_body_mode=false

# 夜未央 //miniapp2.52ywy.com
response if ${url} ~= /^https:\/\/miniapp2\.52ywy\.com\/(?:ywyminiappbot\/(?:getLatest|getLatestAll|getCategoryVideos|getSearch|series|movies|tv|av|getbloger)|player\/getPlayer)(\?|$)/i then script("https://rucu6.pages.dev/Scripts/webpage/52ywy.js") with tag="[WebPage]夜未央", timeout=10, requires_body=true, binary_body_mode=false

# 字母圈 //*.zimuquan*.top, *.zimuquan*.uk, *.zimuquan*.com
response if ${url} ~= /^https?:\/\/[^\/]*zimuquan[^\/]*\/index\.php\/vod\/play\//i then script("https://rucu6.pages.dev/Scripts/webpage/zimuquan.js") with tag="[WebPage]字母圈", timeout=10, requires_body=true, binary_body_mode=false

# E-Hentai //e-hentai.org
response if ${url} ~= /^https:\/\/e-hentai\.org\/g\//i then script("https://rucu6.pages.dev/Scripts/webpage/ehentai.js") with tag="[WebPage]E-Hentai", timeout=10, requires_body=true, binary_body_mode=false

# Hanime1 //hanime1.me
response if ${url} ~= /^https:\/\/hanime1\.me\/(?!(favicon|css|js|cdn-cgi|load))/i then script("https://rucu6.pages.dev/Scripts/webpage/hanime.js") with tag="[WebPage]Hanime1", timeout=10, requires_body=true, binary_body_mode=false

# JavDB //javdb.com
response if ${url} ~= /^https:\/\/javdb\.com\/(?!over18\?)/i then script("https://rucu6.pages.dev/Scripts/webpage/myblockads.js") with tag="[WebPage]JavDB", timeout=10, requires_body=true, binary_body_mode=false

# MissAV //missav.ai, missav.fans, missav.ws
response if ${url} ~= /^https:\/\/missav\.(?:ai|fans|ws)\/(?!favicon)(?!(build|fonts|img|js|api|cdn-cgi)\/)./i then script("https://rucu6.pages.dev/Scripts/webpage/missav.js") with tag="[WebPage]MissAV", timeout=10, requires_body=true, binary_body_mode=false

# PornHub //*.pornhub.com
response if ${url} ~= /^https:\/\/cn\.pornhub\.com\//i then script("https://rucu6.pages.dev/Scripts/webpage/pornhub.js") with tag="[WebPage]PornHub", timeout=10, requires_body=true, binary_body_mode=false

[MitM]
hostname = asserts.avple.tv, e-hentai.org, exhentai.org, *.pornhub.com, boxer.baidu.com, m.baidu.com, www.baidu.com, zhidao.baidu.com, www.hgeme.com, www.xn--wcv59z.com, yhg007.com, *.111107?.xyz, 18hlw.com, 8olbt.imsatcmn.cc, miniapp2.52ywy.com, *.zimuquan*.top, *.zimuquan*.uk, *.zimuquan*.com, hanime1.me, javdb.com, missav.ai, missav.fans, missav.ws