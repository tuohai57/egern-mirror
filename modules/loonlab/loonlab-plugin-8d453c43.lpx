#!name = 本机开发服务回环
#!desc = 将发往目标IP的流量导入TUN并重定向回本机，用于本地开发调试。目标服务需已在本机监听。
#!openUrl = 
#!author = sooyaaabo[https://github.com/sooyaaabo]
#!tag = 开发工具
#!system = 
#!system_version = 
#!loon_version = 3.5.2(1007)
#!homepage = https://loonlab.103516.xyz/Plugin/
#!icon = https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/Other/Loon-Loopback.png
#!date = 2026-10-10 20:00

# 使用说明：
# 1. 开启插件，将开发工具的目标地址设置为你自定义的IP（如 10.7.0.1）。
# 2. 确保目标服务已在本机监听。
# 3. 如需变更IP，请务必保持include-tun与[IP Rewrite]中的地址一致。

[General]
# 关闭TUN的IPv6 VIF
ipv6-vif = off

# 将指定IP引入TUN（示例：10.7.0.1/32）
include-tun = 10.7.0.1/32

[IP Rewrite]
# 将发往该IP的流量原路回环回本机协议栈
10.7.0.1 = reflect