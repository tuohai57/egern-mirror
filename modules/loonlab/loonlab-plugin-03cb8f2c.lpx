#!name = 金山文档
#!desc = 过滤金山文档广告
#!openUrl = https://apps.apple.com/app/id1398120225
#!author = 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!tag = 去广告
#!system = 
#!system_version = 
#!loon_version = 3.5.2(1005)
#!homepage = https://loonlab.103516.xyz/Plugin/
#!icon = https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/KDocs.png
#!date = 2026-10-02 12:00

# 2026-10-02 13:57:49
# https://kelee.one/Tool/Loon/Lpx/WPS_Documents_remove_ads.lpx

[Rewrite]
# 首页横幅广告
request if ${url} ~= /^https:\/\/www\.kdocs\.cn\/kdg\/api\/v1\/cards\/type\/3\?iosVer=\d+\.\d+\.\d+&isGetList=1/i then reject_dict(200)

# 我的页面推广
request if ${url} ~= /^https:\/\/www\.kdocs\.cn\/kdg\/api\/v1\/cards\/type\/27\?iosVer=\d+\.\d+\.\d+&isGetList=1/i then reject_dict(200)

# 表单收集页面推广
request if ${url} ~= /^https:\/\/f-api\.kdocs\.cn\/godfather\/api\/thirdparty\/v1\/viewpager\?showLocal=mobileWebIndex/i then reject_dict(200)

[MitM]
hostname = www.kdocs.cn, f-api.kdocs.cn