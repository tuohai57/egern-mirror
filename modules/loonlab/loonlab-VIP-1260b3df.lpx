[Script]
request if ${url} ~= /^https:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.app\.playerunite\.v1\.Player\/PlayViewUnite/i then script("https://ddgksf2013.top/scripts/bilibili.vip.js") with tag="[哔哩哔哩]大会员Crack_Request", timeout=60, requires_body=true, binary_body_mode=true

response if ${url} ~= /^https?:\/\/app\.bilibili\.com\/x\/v2\/account\//i then script("https://ddgksf2013.top/scripts/bili_myinfo_vip.js") with tag="[哔哩哔哩]大会员Crack_Respone", timeout=60, requires_body=true

[MitM]
hostname = grpc.biliapi.net, app.bilibili.com
