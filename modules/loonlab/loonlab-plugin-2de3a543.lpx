#!name = 掌上英雄联盟
#!desc = 过滤掌上英雄联盟广告
#!openUrl = https://apps.apple.com/app/id475666808
#!author = 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!tag = 去广告
#!system = 
#!system_version = 
#!loon_version = 3.5.2(1005)
#!homepage = https://loonlab.103516.xyz/Plugin/
#!icon = https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/LOL_Bible.png
#!date = 2026-10-02 12:00

# 2026-10-02 13:57:49
# https://kelee.one/Tool/Loon/Lpx/LOL_Bible_remove_ads.lpx

[Rewrite]
# 移除开屏广告、弹窗推广、搜索热搜、搜索热榜、底栏推广图标
request if ${url} ~= /^https:\/\/mlol\.qt\.qq\.com\/go\/recommend\/platstrongshell\?/i then reject_dict(200)

request if ${url} ~= /^https:\/\/mlol\.qt\.qq\.com\/go\/club\/match\/get_ai_search_words$/i then reject_dict(200)

request if ${url} ~= /^https:\/\/mlol\.qt\.qq\.com\/go\/mlol_news\/search\/varcache_hotV\d\?/i then reject_dict(200)

request if ${url} ~= /^https:\/\/mlol\.qt\.qq\.com\/go\/customize_search\/article_rank_tab\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/mlol\.qt\.qq\.com\/go\/customize_search\/article_rank\?/i then reject_dict(200)

request if ${url} ~= /^https:\/\/mlol\.qt\.qq\.com\/go\/zone\/bottomtab_tip\?/i then reject_dict(200)

request if ${url} ~= /^https?:\/\/us\.l\.qq\.com\/exapp/i then reject(200)

request if ${url} ~= /^https?:\/\/ossweb-img\.qq\.com\/upload\/adw\/image\/[0-9]{3}\/202[0-9]{5}\/[a-z0-9]{32}\.(jpg|jpeg)/i then reject(200)

request if ${url} ~= /^https?:\/\/mlol\.qt\.qq\.com\/go\/recommend\/(?!v2\/platactivity.*)/i then reject(404)

[MitM]
hostname = mlol.qt.qq.com, us.l.qq.com, ossweb-img.qq.com