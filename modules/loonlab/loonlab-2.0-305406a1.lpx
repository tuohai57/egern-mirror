# 2026-08-29
# https://ddgksf2013.top/rewrite/StartUpAds.conf

[Rule]
# DiDaChuXing
DOMAIN-SUFFIX, shenshiads.com, REJECT

# LeXiaoTong
DOMAIN-SUFFIX, yfanads.com, REJECT

# NongYeYinHang
