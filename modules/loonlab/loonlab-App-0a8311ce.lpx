#!name = 银行App
#!desc = 过滤部分银行应用广告
#!openUrl = 
#!author = 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md], fmz200[https://github.com/fmz200]
#!tag = 去广告
#!system = 
#!system_version = 
#!loon_version = 3.5.2(1005)
#!homepage = https://loonlab.103516.xyz/Plugin/
#!icon = https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/Other/CNY.png
#!date = 2026-10-02 12:00

# 2026-10-02 13:57:49
# https://kelee.one/Tool/Loon/Lpx/Bank_remove_ads.lpx

[Rule]
# 建设银行
DOMAIN, adv.ccb.com, REJECT

# 广发银行
# 内页广告
URL-REGEX, "^http:\/\/mps\.95508\.com\/mps\/icppweb\/images\/mps\/migration\/mpspics\/", REJECT

[Rewrite]
# 广发银行
# 开屏广告、内页广告
request if ${url} ~= /^https:\/\/static\.95508\.com\/icppweb\/images\/modelMaterial\/advertising\//i then reject(404)
request if ${url} ~= /^https?:\/\/static\.95508\.com\/icppweb\/images\/modelMaterial\/accurate\/202\d{5}\/.*.(png|jpg)/i then reject(200)
request if ${url} ~= /^https?:\/\/static\.95508\.com\/icppweb\/images\/modelMaterial\/advertising\/202\d{5}\/.*.(png|jpg)/i then reject(200)
request if ${url} ~= /^https?:\/\/mps\.95508\.com\/mps\/club\/cardPortals\/adv\/\d{25}\.(png|jpg)/i then reject_img(200)
# 国寿联盟悬浮组件
request if ${url} ~= /^https:\/\/unionsr\.chinalifeonline\.com\.cn\/gslm\/upload\//i then reject(200)

# 中信银行
# 开屏广告 @jFrecht
request if ${url} ~= /^https:\/\/imcs\.citicbank\.com\/cloud\/[a-zA-Z0-9]{32}\.(?:jpg|jpeg|png)\?width=(?:5..|6..|7..|1125|1242|1400|1863|1330|1500|1080)&height=(?:2436|2688|1624|12..|3031|4032|2688|1137|2880|3248|720|23..|1462)/i then reject(404)
request if ${url} ~= /^https?:\/\/(autoload\.bank\.ecitic\.com\/imcslego|imcs\.citicbank\.com)\/cloud\/\w+\.png\?width=([1-9]\d{0,2}|1[0-2]\d\d|1300)&height=(1[5-9]\d\d|2[0-6]\d\d)/i then reject(404)
request if ${url} ~= /^https:\/\/imcs\.citicbank\.com\/cloud\/([a-fA-F0-9]{32})\.(?:jpg|jpeg|png)\?width=[0-9]{4}&height=[0-9]{4}/i then reject(404)
request if ${url} ~= /^https?:\/\/wap\.bank\.ecitic\.com:6443\/NMBFOServer\/cbframework\.do\?act=CUBEPAGEDATA/i then reject(200)
request if ${url} ~= /^https?:\/\/imcs\.citicbank\.com\/cloud\/.+(1125.+2436|1242.+2688|750.+1638|563.+1218)/i then reject_dict(200)

# 浦发银行
request if ${url} ~= /^https:\/\/lban\.spdb\.com\.cn\/mspmk-web-component\/getAdvertisementList\.ah$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/lban\.spdb\.com\.cn\/mspmk-web-component\/getAdvList\.ah$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/lban\.spdb\.com\.cn\/mspmk-web-component\/prefetchAdvList\.ah/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/wap\.spdb\.com\.cn\/mspmk-web-homeassist\/OpenScreenAdv\.ah$/i then reject(404)

# 浦大喜奔
request if ${url} ~= /^https?:\/\/image\.spdbccc\.com\.cn\/group\d\/M00\/[A-Z0-9]{2}\/[A-Z0-9]{2}\/.+(4038|0571|M511|V-008|g549|b0628|fg817|5w501|Jo341|Z4583|oo845|i4905|MY245|YU472|Y401|w428|s000)/i then reject_dict(200)

# 招商银行 
# 开屏广告
request if ${url} ~= /^https:\/\/s3gw\.cmbimg\.com\/mbappinitads\//i then reject(404)
request if ${url} ~= /^https?:\/\/webappcfg\.paas\.cmbchina\.com\/v\d\/func\/getmarketconfig/i then reject(200)
request if ${url} ~= /^https?:\/\/mbmodule-openapi\.paas\.cmbchina\.com\/graphic\/v2\/module\/graphic/i then reject_dict(200)

# 建设银行
request if ${url} ~= /^http:\/\/image1\.ccb\.com\/newsinfo\/eBranch\/check\/(?:nf\/newfin\/activity|po\/poortheme\/activity)\/\w+\.png/i then reject(404)

# 交通银行
request if ${url} ~= /^https?:\/\/download1\.bankcomm\.com\/chngweb\/CHNRCSP\/media/i then reject(404)
request if ${url} ~= /^https?:\/\/download1\.bankcomm\.com\/mobs6-inner\/offline\/static\/releaseConf/i then reject(404)

# 百信银行
request if ${url} ~= /^https?:\/\/mres\.aibank\.com\/app\/resource\/cim\/cim0000001\/.+\.jpg/i then reject(200)

# 北京银行
request if ${url} ~= /^https?:\/\/cdnmobibank\.bankofbeijing\.com\.cn\/cdn\/MarketingCloud\/.+\/.+\/99_1\/.+\.jpg/i then reject(200)

# 掌上京彩
request if ${url} ~= /^https?:\/\/cdn-xyk-app\.bankofbeijing\.com\.cn\/cdn\/resource\/image\/advertise/i then reject(200)

# 光大银行
request if ${url} ~= /^https?:\/\/mobile\.cebbank\.com\/cebclient\/ClientNoticeList/i then reject(200)
request if ${url} ~= /^https?:\/\/yghsh\.cebbank\.com\/static\/picture\/.*.jpg/i then reject(200)

# 工银E生活
request if ${url} ~= /^https?:\/\/pv\.elife\.icbc\.com\.cn\/OFSTPV\/utm\.gif/i then reject(200)

# 广州农商银行
request if ${url} ~= /^https?:\/\/mbank\.grcbank\.com\/ydyh\/resources\/startpage\/.*.(jpg|png)/i then reject(200)

# 华彩生活
request if ${url} ~= /^https?:\/\/static\.creditcard\.hxb\.com\.cn\/mcube\/apps\/group\d\/M00\/00\/2[A-Z0-9]{1}\/amRG7WO.+\.jpg/i then reject(200)

# 汇丰汇选
request if ${url} ~= /^https?:\/\/m\.prod\.app\.hsbcfts\.com\.cn\/api\/sapp\/biz\/config\/open\/queryappversion\?channelCode=/i then reject_dict(200)

# 吉林银行
request if ${url} ~= /^https?:\/\/cdn\.jlbank\.com\.cn\/jlstaticresource\/APPSTART/i then reject(200)

# 建行生活
# 首页横幅广告
request if ${url} ~= /^https?:\/\/yunbusiness\.ccb\.com\/clp_service\/txCtrl\?txcode=A3341A(002|006|009|119|120)/i then reject(200)
request if ${url} ~= /^https?:\/\/yunbusiness\.ccb\.com\/clp_service\/txCtrl\?txcode=A3341C147/i then reject(200)
# 我的页面悬浮广告
response if ${url} ~= /^https?:\/\/yunbusiness\.ccb\.com\/basic_service\/txCtrl\?/i then response.body.replace(/"TAG_AD_INFO"/, "\"fmz200\"")
response if ${url} ~= /^https?:\/\/yunbusiness\.ccb\.com\/basic_service\/txCtrl\?txcode=A3341AB05/i then response.body.mock_file("json", "https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/ccbLife/A3341AB05.json", 200)
# 内置饿了么
request if ${url} ~= /^https?:\/\/waimai-guide\.ele\.me\/\w+\/mtop\.alsc\.eleme\.\w+\.trigger\.respond/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/waimai-guide\.ele\.me\/\w+\/mtop\.alsc\.wamai\.store\.detail\.miniapp\.popup/i then reject(404)
request if ${url} ~= /^https?:\/\/waimai-guide\.ele\.me\/\w+\/mtop\.venus\.shopcouponpopupservice\.getshopcouponspopup/i then reject(404)
response if ${url} ~= /^https?:\/\/waimai-guide\.ele\.me\/\w+\/mtop\.venus\.shopresourceservice\.getshopresource/i then response.body.replace(/posterList/, "fmz200")

# 民生银行
request if ${url} ~= /^https?:\/\/www\.cmbc\.com\.cn\/m\/image\/loadingpage\//i then reject(200)
request if ${url} ~= /^https?:\/\/www\.cmbc\.com\.cn\/m\/image\/banner\/.*.png/i then reject(200)

# 农业银行
request if ${url} ~= /^https?:\/\/midc\.cdn-static\.abchina\.com\.cn\/distributecenterimg\/file\/download\/(ed64|74b5)/i then reject(404)
request if ${url} ~= /^https?:\/\/enjoy\.cdn-static\.abchina\.com\/yx-engine-web\/file\/download\/(?!7dc2|fe96|cea3|06a8|1b11|d57b|6918|61db|2d58|aa23|)/i then reject(200)
request if ${url} ~= /^https?:\/\/firefly\.abchina\.com\.cn\/firefly-collection\/Collect/i then reject(200)

# 平安口袋银行
request if ${url} ~= /^https?:\/\/cdn\.sdb\.com\.cn\/widget\/magic-module-sprite\/general-banner/i then reject(200)
request if ${url} ~= /^https?:\/\/cdn\.sdb\.com\.cn\/widget\/magic-module-sprite\/dialog-normal/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/cdn\.sdb\.com\.cn\/widget\/pb\/pb-plugins-recomend-content/i then reject_dict(200)

# 平安壹钱包
request if ${url} ~= /^https?:\/\/mobile\.1qianbao\.com\/mtp-web\/ui\/op_common_query_business_yqb\.json/i then reject(200)

# 平安证券
request if ${url} ~= /^https?:\/\/pacdn\.m\.stock\.pingan\.com\/images\//i then reject_dict(200)

# 天府手机银行
request if ${url} ~= /^https?:\/\/cgbank\.oss-cn-shenzhen\.aliyuncs\.com\/visual\/advertisingImg\/.+.jpg/i then reject(200)

# 天府银行小程序
response if ${url} ~= /^https?:\/\/chl\.tf\.cn\/channelmg\/sys\/socso\/order\/queryOrderInfo/i then response.body.replace(/"imgUrl"/, "\"imgUrl0\"")
request if ${url} ~= /^https?:\/\/chl\.tf\.cn\/channelmg\/sys\/socso\/socsonew\/queryIsRealNameAdertInfo/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/wechat\.tf\.cn\/mini-financial\/model\/queryPopup/i then reject_dict(200)

# 兴业银行
request if ${url} ~= /^https?:\/\/images\.cib\.com\.cn\/commons\/uploads\/commons\/[a-zA-Z0-9]{32}\.jpg\?ver=20221[1-2]{1}/i then reject(200)
request if ${url} ~= /^https?:\/\/file\.cibfintech\.com\/file\/M0[1-9]{1}\/*\/*\/.*.zip/i then reject_img(200)

# 兴业证券
request if ${url} ~= /^https?:\/\/static.xyzq.cn\/image\/splash\/opera3.*.jpg/i then reject(200)

# 邮储银行
request if ${url} ~= /^https?:\/\/static.psbc.com:8090\/mbank_f\/images\/[0-9]+\.png/i then reject(200)
request if ${url} ~= /^https?:\/\/mcc.psbc.com:9090\/mcc\/resources\/[0-9]+\.(jpg|png)/i then reject(200)

# 邮储信用卡
request if ${url} ~= /^https?:\/\/d\.psbc\.com:9091\/mcc\/resources\/[0-9]+\.(jpg|png|jpeg)/i then reject(200)
request if ${url} ~= /^https?:\/\/static\.mobile-bank\.psbc\.com\/mgs/i then reject(404)

# 中国银行
request if ${url} ~= /^https?:\/\/mlife\.jf365\.boc\.cn\/AppPrj\/FirstPic\.do\?txnId=2PIC000001/i then reject(200)

# 掌上生活
request if ${url} ~= /^https?:\/\/mbasecc\.(bas|bcs)\.cmbchina\.com\/Edge\/api\/mlife\.clientface\.clientservice\.api\.advertiseService\/preCacheAdvertiseSec/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/intellicc\.bas\.cmbchina\.com\/Edge\/api\/mlife\.intelli\.render\.api\.render\/getDynamicDataSec/i then reject(404)
request if ${url} ~= /^https?:\/\/intellicc\.bcs\.cmbchina\.com\/Edge\/api\/mlife\.intelli\.adrender\.api\.AdWork\/getAdsBySlotId/i then reject_dict(200)

# 众邦银行
request if ${url} ~= /^https?:\/\/direct\.z-bank\.com\/portal\/AdvertImageDownLoad4Mobile\.do/i then reject(200)

# 中银跨境GO
# request if ${url} ~= /^https?:\/\/openapi\.boc\.cn\/unlogin\/app\/cbsp\/query_ad_list/i then reject(200)

[MitM]
hostname = static.95508.com, mps.95508.com, unionsr.chinalifeonline.com.cn, imcs.citicbank.com, autoload.bank.ecitic.com, wap.bank.ecitic.com, lban.spdb.com.cn, wap.spdb.com.cn, image.spdbccc.com.cn, s3gw.cmbimg.com, webappcfg.paas.cmbchina.com, mbmodule-openapi.paas.cmbchina.com, image1.ccb.com, download1.bankcomm.com, mres.aibank.com, cdnmobibank.bankofbeijing.com.cn, cdn-xyk-app.bankofbeijing.com.cn, mobile.cebbank.com, yghsh.cebbank.com, pv.elife.icbc.com.cn, mbank.grcbank.com, static.creditcard.hxb.com.cn, m.prod.app.hsbcfts.com.cn, cdn.jlbank.com.cn, yunbusiness.ccb.com, waimai-guide.ele.me, www.cmbc.com.cn, midc.cdn-static.abchina.com.cn, enjoy.cdn-static.abchina.com, firefly.abchina.com.cn, cdn.sdb.com.cn, mobile.1qianbao.com, pacdn.m.stock.pingan.com, cgbank.oss-cn-shenzhen.aliyuncs.com, chl.tf.cn, wechat.tf.cn, images.cib.com.cn, file.cibfintech.com, static.xyzq.cn, static.psbc.com, mcc.psbc.com, d.psbc.com, static.mobile-bank.psbc.com, mlife.jf365.boc.cn, mbasecc.bas.cmbchina.com, mbasecc.bcs.cmbchina.com, intellicc.bas.cmbchina.com, intellicc.bcs.cmbchina.com, direct.z-bank.com