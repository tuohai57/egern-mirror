#!name = 航旅纵横
#!desc = 过滤航旅纵横广告
#!openUrl = https://apps.apple.com/app/id480161784
#!author = ddgksf2013[https://github.com/ddgksf2013]
#!tag = 去广告
#!system = 
#!system_version = 
#!loon_version = 3.5.2(1005)
#!homepage = https://loonlab.103516.xyz/Plugin/
#!icon = https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/Umetrip.png
#!date = 2026-10-05 15:00

# 2026-10-02 13:57:49
# https://kelee.one/Tool/Loon/Lpx/Umetrip_remove_ads.lpx
# 2026-10-05
# hhttps://ddgksf2013.top/rewrite/UmetripAds.conf

[Rule]
# URL-REGEX, "^http?:\/\/(discardrp|startup)\.umetrip\.com\/gateway\/api\/umetrip\/native", REJECT

[Rewrite]
request if ${url} ~= /^https:\/\/oss\.umetrip\.com\/fs\/advert\//i then reject_img(200)

[Script]
# response if ${url} ~= /^http?:\/\/(114\.115\.217\.129)|(home\.umetrip\.com)\/gateway\/api\/umetrip\/native$/i then script("https://kelee.one/Resource/JavaScript/Umetrip/Umetrip_remove_ads.js") with tag="[航旅纵横]移除首页广告"

response if ${url} ~= /^https:\/\/(?:sns|appmsg|home|umehome|opactivity|activity|umerp|flightstatus|umeflightstatus|startup|umestartup|user|umeuser|event)\.umetrip\.com\/gateway\/api\/umetrip\/native(?:\?.*)?$/i then script("https://ddgksf2013.top/scripts/umetrip.ads.js") with tag="[航旅纵横]移除广告"

[MitM]
hostname = sns.umetrip.com, appmsg.umetrip.com, home.umetrip.com, umehome.umetrip.com, opactivity.umetrip.com, activity.umetrip.com, umerp.umetrip.com, flightstatus.umetrip.com, umeflightstatus.umetrip.com, startup.umetrip.com, umestartup.umetrip.com, user.umetrip.com, umeuser.umetrip.com, event.umetrip.com, oss.umetrip.com
