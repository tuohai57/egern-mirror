#!name = 汽水音乐
#!desc = 过滤汽水音乐广告
#!openUrl = https://apps.apple.com/app/id1605585211
#!author = 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!tag = 去广告
#!system = 
#!system_version = 
#!loon_version = 3.5.2(1005)
#!homepage = https://loonlab.103516.xyz/Plugin/
#!icon = https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/SodaMusic.png
#!date = 2026-10-02 12:00

# 2026-10-02 13:57:49
# https://kelee.one/Tool/Loon/Lpx/SodaMusic_remove_ads.lpx

[Rewrite]
# 移除开屏广告、弹窗广告、播放器推广、歌曲详情界面视频推广、播放页面的歌曲视频，精简首页和我的页面
response if ${url} ~= /^https:\/\/tnc\d-(bjlgy|ali[a-z]{2})\d?\.zijieapi\.com\/get_domains\/v\d\/\?/i then response.json.replace(["data.opaque_data_enabled", "data.ttnet_http_dns_enabled", "data.ttnet_quic_enabled", "data.ttnet_tt_http_dns"], [0, 0, 0, 0])

response if ${url} ~= /^https:\/\/tnc\d-(bjlgy|ali[a-z]{2})\d?\.zijieapi\.com\/get_domains\/v\d\/\?/i then response.json.jq(".data.ttnet_dispatch_actions |= map(select(.action != \"dispatch\" and .action != \"tc\"))")

# 追加的销售配置
request if ${url} ~= /^https:\/\/(beta-luna\.douyin|api5-lq\.qishui)\.com\/luna\/commerce\/upsells_config\?/i then reject_dict(200)

# 广告下发
request if ${url} ~= /^https:\/\/(api|api5-lq)\.qishui\.com\/luna\/ads\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/(beta-luna\.douyin|api5-lq\.qishui)\.com\/luna\/ads\//i then reject_dict(200)

# 发现页面 - 正在直播Add commentMore actions
request if ${url} ~= /^https:\/\/webcast-open\.douyin\.com\/webcast\/openapi\/feed\/\?/i then reject_dict(200)

# 签到入口
request if ${url} ~= /^https:\/\/(beta-luna\.douyin|api5-lq\.qishui)\.douyin\.com\/luna\/treasure\/entrance\/config\?/i then reject_dict(200)

# 我的页面 - 看视频免费听歌60分钟
response if ${url} ~= /^https:\/\/(beta-luna\.douyin|api5-lq\.qishui)\.douyin\.com\/luna\/me\?/i then response.json.delete("reward_ad_banner")

# 搜索页面 - 横幅推广
request if ${url} ~= /^https:\/\/(beta-luna\.douyin|api5-lq\.qishui)\.douyin\.com\/luna\/activities\?/i then reject_dict(200)

# 播放页面 - 视频流
# response if ${url} ~= /^https:\/\/(beta-luna\.douyin|api5-lq\.qishui)\.douyin\.com\/luna\/me\/recently-played-media\?/i then response.json.jq(".media |= map(select(.type != \"video\"))")
response if ${url} ~= /^https:\/\/(beta-luna\.douyin|api5-lq\.qishui)\.douyin\.com\/luna\/feed\/song-tab\?/i then response.json.jq("del(.items[] | select(.type == \"video_track_mix\"))")

# 播放器界面 - 播放进度条提示语
response if ${url} ~= /^https:\/\/(beta-luna\.douyin|api5-lq\.qishui)\.douyin\.com\/luna\/card\?/i then response.json.delete("preview_guide")

# 播放器界面 - 你关注的人喜欢了
response if ${url} ~= /^https:\/\/(beta-luna\.douyin|api5-lq\.qishui)\.douyin\.com\/luna\/card\?/i then response.json.jq("del(.card_items[] | select(has(\"priority_display\")))")

# 播放器 - 视频广告
request if ${url} ~= /^https:\/\/(beta-luna\.douyin|api5-lq\.qishui)\.douyin\.com\/luna\/media_ads\?/i then reject_dict(200)

# 歌曲详情 - 热门视频
response if ${url} ~= /^https:\/\/(beta-luna\.douyin|api5-lq\.qishui)\.douyin\.com\/luna\/more-panel\?/i then response.json.jq(".blocks |= map(select(.type != \"related_video\"))")

# 免费听歌推广
request if ${url} ~= /^https:\/\/(beta-luna\.douyin|api5-lq\.qishui)\.douyin\.com\/luna\/commerce\/upsells\?/i then reject_dict(200)

# 邀请开通会员弹窗
request if ${url} ~= /^https:\/\/(beta-luna\.douyin|api5-lq\.qishui)\.douyin\.com\/luna\/commerce\/v2\/commerce_info\?/i then reject_dict(200)

# 抖音看过悬浮窗
request if ${url} ~= /^https:\/\/(beta-luna\.douyin|api5-lq\.qishui)\.douyin\.com\/luna\/listen-video\/reminder\?/i then reject_dict(200)

[Script]
# 播放页面 - 视频流[响应体太大]
response if ${url} ~= /^https:\/\/(beta-luna\.douyin|api5-lq\.qishui)\.douyin\.com\/luna\/me\/recently-played-media\?/i then script("https://kelee.one/Resource/JavaScript/SodaMusic/SodaMusic_remove_ads.js") with tag="[汽水音乐]移除播放页面视频流", requires_body=true

[MitM]
hostname = webcast-open.douyin.com, beta-luna.douyin.com, api.qishui.com, api5-lq.qishui.com, tnc*-*.zijieapi.com