#!name = RevenueCat
#!desc = 支持解锁RevenueCat、Superwall和Adapty（Adapty需卸载重装后生效）。\n遇到解锁后报错或闪退的 App，可在插件设置中填入名称跳过；默认「-」表示全部 App 解锁。
#!openUrl = 
#!author = ios151[https://github.com/ios151]
#!tag = 解锁会员
#!system = 
#!system_version = 
#!loon_version = 3.5.2(1005)
#!homepage = https://loonlab.103516.xyz/Plugin/
#!icon = https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/RevenueCat.png
#!date = 2026-10-06 17:00

# https://reven.jsforbaby.workers.dev/reven/reven.lpx

[Argument]
Bypass = input, "-", tag = 跳过指定App会员解锁, desc = 对修改响应会报错的App，可填UA关键词跳过解锁；多个用逗号分隔。默认-表示全部解锁。
Strategy = select, "auto", "lifetime_sub", "year", "month", "all", tag = 解锁策略, desc = auto使用官方规范；lifetime_sub兼容旧版App，将永久订阅加入subscriptions并延长至2099年；year/month仅注入对应期限订阅，不处理永久订阅；all注入全部PID。永久订阅解锁失败时，优先尝试lifetime_sub。

[Script]
request if ${url} ~= /^https:\/\/(api\.revenuecat\.com|api\.rc-backup\.com|rc\.visionarytech\.ltd|revenue\.cuto\.app|proxy\.linearity\.io|subscriptions-api\.superwall\.com|api\.adapty\.io)\//i then script("https://reven.jsforbaby.workers.dev/reven/loon-redirect.js", {${Bypass}, ${Strategy}}) with tag="[RevenueCat]Crack Relay", requires_body=true

[MitM]
hostname = api.revenuecat.com, api.rc-backup.com, rc.visionarytech.ltd, revenue.cuto.app, proxy.linearity.io, subscriptions-api.superwall.com, api.adapty.io